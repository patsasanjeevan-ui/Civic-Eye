# CivicEye-Agent Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Ollama Localhost Configuration
OLLAMA_HOST=http://localhost:11434
DEFAULT_GEMMA_MODEL=gemma4:e4b

# PostgreSQL / PostGIS Database Configuration
# If database is unavailable, backend automatically activates resilient in-memory storage
DATABASE_URL=postgres://postgres:postgres@localhost:5432/civiceye

# Optional Gemini API Key for hybrid cloud burst mode fallback
GEMINI_API_KEY=
